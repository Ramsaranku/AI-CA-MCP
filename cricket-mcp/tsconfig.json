{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "data",
    "analyze-aus-pace-tactics.ts",
    "check-aus-ban-tests.ts",
    "check-match-status.ts",
    "predict-batsmen.ts",
    "predict-spain-finland.ts",
    "predict-tomorrow.ts",
    "query-kohli-bumrah.ts",
    "squad-prediction.ts"
  ]
}