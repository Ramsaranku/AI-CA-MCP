{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "index.ts",
    "backends/**/*.ts",
    "db/**/*.ts",
    "ingest/**/*.ts",
    "prompts/**/*.ts",
    "queries/**/*.ts",
    "tools/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "data",
    "evals",
    "*.ts"
  ]
}